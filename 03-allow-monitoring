apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-monitoring
  namespace: roboshop
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  ingress:
  - from:
    - namespaceSelector: #it go and select the monitoring namespace project isolated space
        matchLabels:
          project: monitoring
    ports:
    - protocol: TCP
      port: 9090